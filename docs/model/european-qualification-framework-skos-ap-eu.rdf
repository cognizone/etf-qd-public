	<rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
	<rdf:value xml:lang="ro">Cunoștințe generale de bază competențe de bază necesare pentru a efectua sarcini simple muncă sau studiu sub supraveghere directă.</rdf:value>
	<created xmlns="http://purl.org/dc/terms/" rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-16</created>
</rdf:Description>

