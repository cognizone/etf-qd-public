	<status xmlns="http://publications.europa.eu/ontology/euvoc#" rdf:resource="http://publications.europa.eu/resource/authority/concept-status/CURRENT"/>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/snb/eqf/label_5cbbcf0371">
	<rdf:type rdf:resource="http://www.w3.org/2008/05/skos-xl#Label"/>
	<created xmlns="http://purl.org/dc/terms/" rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-12-03</created>
	<startDate xmlns="http://publications.europa.eu/ontology/euvoc#" rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-12-17</startDate>
	<type xmlns="http://purl.org/dc/terms/" rdf:resource="http://publications.europa.eu/resource/authority/label-type/STANDARDLABEL"/>
	<versionInfo xmlns="http://www.w3.org/2002/07/owl#">V.4</versionInfo>
	<literalForm xmlns="http://www.w3.org/2008/05/skos-xl#" xml:lang="pt">Nível 5</literalForm>
	<status xmlns="http://publications.europa.eu/ontology/euvoc#" rdf:resource="http://publications.europa.eu/resource/authority/concept-status/CURRENT"/>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/snb/eqf/note_f506e7a4a6">
	<rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
	<rdf:value xml:lang="is">Staðreynda- og fræðileg þekking í víðu samhengi innan starfssviðs eða náms á sviði vitsmunalegrar og hagnýtrar færni sem þarf til að leysa tiltekin vandamál á starfssviði eða námssviði, temja sér sjálfsstæði í stjórnun verkefna innan leiðbeininga vinnu- eða námssamhengis sem venjulega eru fyrirsjáanlegar en geta breyst með tilliti til leiðbeinanda og venjubundinni vinnu annarra, taka ábyrgð á mati og umbótum á vinnu- eða námsstarfsemi.</rdf:value>
	<created xmlns="http://purl.org/dc/terms/" rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-16</created>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/snb/eqf/note_f202d85c9b">
	<rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
	<rdf:value xml:lang="no">Grunnleggende allmennkunnskap, grunnleggende ferdigheter som kreves for å utføre enkle oppgaver, arbeid eller studier under direkte veiledning i en strukturert kontekst.</rdf:value>
	<created xmlns="http://purl.org/dc/terms/" rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-16</created>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/snb/eqf/note_ca6254fef4">
	<rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
	<rdf:value xml:lang="lv">Vispusīgas, specializētas, faktos balstītas un teorētiskas zināšanas konkrētā darba vai studiju jomā, kā arī izpratne par šo zināšanu robežām – vispusīgs kognitīvo un praktisko prasmju kopums, kas nepieciešams, lai izstrādātu radošus risinājumus abstraktām problēmām – vadība un uzraudzība tādu darba vai studiju aktivitāšu kontekstā, kas pakļautas neparedzamām pārmaiņām – sava un citu snieguma izvērtēšana un uzlabošana.</rdf:value>
	<created xmlns="http://purl.org/dc/terms/" rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-16</created>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/snb/eqf/label_b0bf4017a6">
	<rdf:type rdf:resource="http://www.w3.org/2008/05/skos-xl#Label"/>
	<created xmlns="http://purl.org/dc/terms/" rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-12-03</created>
	<startDate xmlns="http://publications.europa.eu/ontology/euvoc#" rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-12-17</startDate>
