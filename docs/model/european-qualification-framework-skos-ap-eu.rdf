<rdf:Description rdf:about="http://data.europa.eu/snb/eqf/note_e6305dbe69">
	<rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
	<rdf:value xml:lang="en">&lt;html:div xmlns:html="http://www.w3.org/1999/xhtml" class="Knowledge"&gt;basic factual knowledge of a field of work or study&lt;/html:div&gt;
          &lt;html:div xmlns:html="http://www.w3.org/1999/xhtml" class="Skill"&gt;basic cognitive and practical skills required to use relevant information in order to carry out tasks and to solve routine problems using simple rules and tools&lt;/html:div&gt;
          &lt;html:div xmlns:html="http://www.w3.org/1999/xhtml" class="Competence"&gt;work or study under supervision with some autonomy&lt;/html:div&gt;</rdf:value>
	<created xmlns="http://purl.org/dc/terms/" rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-06-15</created>
</rdf:Description>

