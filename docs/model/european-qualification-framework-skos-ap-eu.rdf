<rdf:Description rdf:about="http://data.europa.eu/snb/eqf/note_32c711ee28">
	<rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
	<rdf:value xml:lang="en">&lt;html:div xmlns:html="http://www.w3.org/1999/xhtml" class="Note"&gt;The descriptor for the higher education short cycle (within or linked to the first cycle), developed by the Joint Quality Initiative as part of the Bologna process, corresponds to the learning outcomes for EQF level 5.&lt;/html:div&gt;</rdf:value>
	<created xmlns="http://purl.org/dc/terms/" rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-06-15</created>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/snb/eqf/label_de4ac17008">
	<rdf:type rdf:resource="http://www.w3.org/2008/05/skos-xl#Label"/>
	<created xmlns="http://purl.org/dc/terms/" rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-12-03</created>
