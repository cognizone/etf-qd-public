	<xlDefinition xmlns="http://publications.europa.eu/ontology/euvoc#" rdf:resource="http://data.europa.eu/snb/eqf/note_4289b84687"/>
	<xlDefinition xmlns="http://publications.europa.eu/ontology/euvoc#" rdf:resource="http://data.europa.eu/snb/eqf/note_0288df94ce"/>
	<xlDefinition xmlns="http://publications.europa.eu/ontology/euvoc#" rdf:resource="http://data.europa.eu/snb/eqf/note_f506e7a4a6"/>
	<xlDefinition xmlns="http://publications.europa.eu/ontology/euvoc#" rdf:resource="http://data.europa.eu/snb/eqf/note_57a121a329"/>
