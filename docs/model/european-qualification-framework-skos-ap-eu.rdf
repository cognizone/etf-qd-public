<rdf:Description rdf:about="http://data.europa.eu/snb/eqf/25831c2">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
	<created xmlns="http://purl.org/dc/terms/" rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-06-15</created>
	<versionInfo xmlns="http://www.w3.org/2002/07/owl#">V.4</versionInfo>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">&lt;html:div xmlns:html="http://www.w3.org/1999/xhtml" class="Knowledge"&gt;In the context of EQF, knowledge is described as theoretical and/or factual&lt;/html:div&gt;
          &lt;html:div xmlns:html="http://www.w3.org/1999/xhtml" class="Skill"&gt;In the context of EQF, skills are described as cognitive (involving the use of logical, intuitive and creative thinking) and practical (involving manual dexterity and the use of methods, materials, tools and instruments)&lt;/html:div&gt;
          &lt;html:div xmlns:html="http://www.w3.org/1999/xhtml" class="Competence"&gt;In the context of EQF, competence is described in terms of responsibility and autonomy&lt;/html:div&gt;</definition>
